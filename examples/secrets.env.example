# Copy to secrets.env, fill in, and keep it private: chmod 600 secrets.env
# One KEY=value per line. An agent gets only the keys its file names under `secrets`.

# The login for your Claude plan, from `claude setup-token`. Every agent gets it.
CLAUDE_CODE_OAUTH_TOKEN=replace-with-your-token

# Email delivery through Resend (https://resend.com). Read by Nightshift itself, never given to Claude.
RESEND_API_KEY=re_replace_me
REPORT_TO=you@example.com
REPORT_FROM=Nightshift <nightshift@example.com>

# Used by site-check.md.
SITE_URL=https://example.com

# Only with `billing: api` in an agent file. Never set it for agents on your plan login.
# ANTHROPIC_API_KEY=sk-ant-replace-me
