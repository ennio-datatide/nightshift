{
  "name": "nightshift",
  "version": "0.1.0",
  "description": "Headless Claude Code sessions as personal agents: one Markdown file per agent, run on your own Claude login.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nightshift": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
