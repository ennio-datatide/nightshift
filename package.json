{
  "name": "nightshift",
  "version": "0.1.0",
  "description": "Personal agents as headless Claude Code sessions: one Markdown file per agent, run on a schedule on your own Claude login, with least privilege.",
  "keywords": [
    "claude",
    "claude-code",
    "agent-sdk",
    "ai-agents",
    "agents",
    "cron",
    "scheduler",
    "automation",
    "headless"
  ],
  "license": "MIT",
  "author": "Ennio Maldonado",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ennio-datatide/nightshift.git"
  },
  "homepage": "https://github.com/ennio-datatide/nightshift#readme",
  "bugs": {
    "url": "https://github.com/ennio-datatide/nightshift/issues"
  },
  "type": "module",
  "bin": {
    "nightshift": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "croner": "^11.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
